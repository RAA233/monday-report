MONDAY_REPORT_API_HOST=127.0.0.1
MONDAY_REPORT_API_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_MONDAY_REPORT_API_KEY=replace-with-client-api-key-for-local-client-mode
MONDAY_REPORT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MONDAY_REPORT_CLIENT_DATA_MODE=demo
MONDAY_REPORT_STATE_PATH=.local_data/monday_report_state.json
MONDAY_REPORT_STORAGE_ROOT=.local_data/storage
MONDAY_REPORT_EXPORT_ROOT=.local_data/exports
MONDAY_REPORT_MAX_UPLOAD_BYTES=104857600
MONDAY_REPORT_MAX_ZIP_ENTRIES=200
MONDAY_REPORT_MAX_ZIP_UNCOMPRESSED_BYTES=104857600
MONDAY_REPORT_RETENTION_DAYS=365
MONDAY_REPORT_MALWARE_SCANNER=builtin
MONDAY_REPORT_API_KEY=replace-with-at-least-24-random-characters
MONDAY_REPORT_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Keyed audit integrity (HMAC-SHA256), at least 32 bytes. REQUIRED in client mode:
# without a valid active key every protected route fails closed and no audit event
# can be appended. Optional in demo mode. Rotate by moving the current key into
# MONDAY_REPORT_AUDIT_HMAC_RETAINED_KEYS (verification-only) and issuing a new
# active key with an incremented version.
MONDAY_REPORT_AUDIT_HMAC_KEY=replace-with-at-least-32-random-bytes
MONDAY_REPORT_AUDIT_HMAC_KEY_ID=audit-primary
MONDAY_REPORT_AUDIT_HMAC_KEY_VERSION=1
# MONDAY_REPORT_AUDIT_HMAC_RETAINED_KEYS=[{"key_id":"audit-primary","key_version":1,"secret":"..."}]
MONDAY_REPORT_LOCAL_LLM_RUNTIME=ollama
MONDAY_REPORT_LOCAL_LLM_MODEL=gemma4:e2b
OLLAMA_HOST=http://127.0.0.1:11434
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234
#
# Answer generation provider (server/operator-controlled; default: deterministic
# built-in analysis). Set to "local" to have a LOCAL model on THIS computer write the
# answer prose from the same grounded evidence. Nothing from a request or user can select
# this — only the process environment. The loopback runtime is validated: OLLAMA_HOST /
# LM_STUDIO_BASE_URL must be 127.0.0.1 / localhost / ::1 (LAN / public / docker-bridge /
# remote hosts are refused), and requests never use a system proxy. Any failure
# (runtime down, model missing, timeout, malformed) falls back to built-in analysis.
# MONDAY_REPORT_AI_PROVIDER=local
#
# For LOCAL generation, MONDAY_REPORT_LOCAL_LLM_MODEL above must name a model ACTUALLY
# installed in the loopback runtime (it is never assumed). "gemma4:e2b" is only the
# diagnostic reachability-probe default. Recommended, verified test model:
#   qwen2.5:3b     (~1.9 GB, Qwen license)      -> ollama pull qwen2.5:3b
# Lighter Apache-2.0 fallback:
#   qwen2.5:1.5b   (~986 MB, Apache-2.0)        -> ollama pull qwen2.5:1.5b
# The model is supplied/pulled by the operator; no model weights are bundled.
MONDAY_REPORT_HOSTED_FALLBACK_ENABLED=false
MONDAY_REPORT_REPOSITORY_BACKEND=local_json
MONDAY_REPORT_QUEUE_BACKEND=inline_worker
MONDAY_REPORT_PRODUCTION_PARSERS=false
MONDAY_REPORT_GOLDEN_FIXTURE_MANIFEST=output/fixtures/anonymized/golden_fixture_manifest.json
MONDAY_REPORT_PARSER_EVAL_REPORT=output/parser-evals/parser_fixture_eval_report.json
MONDAY_REPORT_DATABASE_URL=postgresql://monday_report:monday_report@127.0.0.1:5432/monday_report
MONDAY_REPORT_REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql://monday_report:monday_report@127.0.0.1:5432/monday_report
REDIS_URL=redis://127.0.0.1:6379/0
